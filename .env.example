# Copy to .env for local use. On Render, set these under Environment instead. NEVER commit the real .env.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>
JWT_SECRET=<long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">

# Where the frontend lives (comma-separated). Leave unset to allow any origin.
CORS_ORIGINS=https://your-site.netlify.app

# OTP email - pick ONE:
# (A) Brevo HTTPS API - REQUIRED on Render's free tier, which blocks SMTP ports
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@example.com
# (B) Gmail SMTP - works locally / on paid hosts only
EMAIL_USER=
EMAIL_PASS=
